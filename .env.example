# ---- CarFinder configuration -------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# In production these are set as Heroku Config Vars, not from a file.

# --- Geocoding (Mapbox) ---
MAPBOX_TOKEN=pk.your_mapbox_token_here

# --- Inventory (Booking.com via RapidAPI) ---
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=booking-com15.p.rapidapi.com
# Base URL is derived from the host; override only if your RapidAPI listing differs.
RAPIDAPI_BASE_URL=https://booking-com15.p.rapidapi.com

# --- Cache (Redis) ---
# If unset/unreachable, the app falls back to an in-memory cache (dev only).
REDIS_URL=redis://localhost:6379/0

# --- Behaviour tuning (sane defaults; override as needed) ---
SUGGEST_TTL_SECONDS=1209600        # 14 days — city/airport coords don't move
SEARCH_TTL_SECONDS=600             # 10 min — prices move, but not second-to-second
JOB_TTL_SECONDS=900                # 15 min — how long a finished search job is retrievable
UPSTREAM_TIMEOUT_SECONDS=15        # hard cap, below Heroku's 30s router timeout
UPSTREAM_MAX_RETRIES=2
BREAKER_FAIL_THRESHOLD=5           # consecutive failures before the breaker opens
BREAKER_RESET_SECONDS=30           # how long the breaker stays open before half-open probe

# --- Rate limiting (per client, sliding window) ---
SUGGEST_RATE_LIMIT=30              # requests
SUGGEST_RATE_WINDOW=60             # per seconds
SEARCH_RATE_LIMIT=15
SEARCH_RATE_WINDOW=60

# --- Misc ---
DEFAULT_CURRENCY=USD
# Booking V2 derives pricing/currency from the country of residence (there is no
# currency_code param). Two-letter code.
DEFAULT_COUNTRY_OF_RESIDENCE=us
CORS_ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Ops portal / payments (required in production) ---
SESSION_SECRET=a-long-random-string        # app refuses to boot on Heroku without it
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox                          # sandbox | production
PAYPAL_WEBHOOK_ID=                          # without it, PayPal webhooks are REJECTED
# PAYPAL_WEBHOOK_ALLOW_UNVERIFIED=true      # local testing only — never in production

# --- Checkout pricing (server-side; the browser can't change these) ---
QUOTE_TTL_SECONDS=7200             # how long search prices stay bookable
ORDER_TTL_SECONDS=10800            # how long a PayPal order stays usable
INSURANCE_ENABLED=true
INSURANCE_LABEL=Full Coverage (CDW + theft)
INSURANCE_CDW_NET_PER_DAY=8.99
INSURANCE_MARKUP=0.40

# --- Abuse limits ---
REQUESTS_RATE_LIMIT=5              # reservations per client per window
REQUESTS_RATE_WINDOW=600
ORDER_RATE_LIMIT=10
ORDER_RATE_WINDOW=600
LOOKUP_RATE_LIMIT=10
LOOKUP_RATE_WINDOW=600
DETAIL_RATE_LIMIT=30
DETAIL_RATE_WINDOW=60
UPSTREAM_DAILY_CAP=0               # max paid booking-API calls per UTC day (0 = no cap)

# --- Ops endpoints ---
METRICS_TOKEN=                     # /metrics?token=...  (falls back to CANARY_TOKEN; unset = hidden)
ENABLE_DOCS=false                  # /docs and /openapi.json

# --- Email (confirmations, cancellations, review invites) ---
EMAIL_SENDER=carrental@reservationdes.online   # From address (verified in Brevo)
EMAIL_FROM_NAME=Reservation Desk
SUPPORT_EMAIL=                                 # Reply-To address customers can write to
BREVO_API_KEY=                                 # Brevo → SMTP & API → API keys. Preferred:
                                               # Railway blocks SMTP on Free/Trial/Hobby plans.
# SMTP fallback (only if BREVO_API_KEY is empty; needs Railway Pro):
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=                                 # e.g. 1234567@smtp-brevo.com
EMAIL_PASSWORD=                                # SMTP key

# Slack Incoming Webhook for booking alerts + the daily digest (web app AND cron)
SLACK_WEBHOOK_URL=
# Optional: base URL for admin links in Slack (defaults to the Railway domain)
ADMIN_BASE_URL=

# Slack remote control (see app/routers/slack.py)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# who may act from Slack: SlackMemberID:admin-login-email[,more]
SLACK_ADMINS=
